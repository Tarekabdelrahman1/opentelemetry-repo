# ==========================================
# Stage 1: Build Stage (The Heavy Lifter)
# ==========================================
FROM eclipse-temurin:21-jdk AS builder

# Set the working directory
WORKDIR /usr/src/app/

# Copy Gradle files FIRST to leverage Docker cache
COPY gradlew .
COPY gradle gradle
COPY build.gradle .
COPY settings.gradle .

# Grant execution permissions to the Gradle wrapper
RUN chmod +x ./gradlew

# Download dependencies (cached if files above haven't changed)
RUN ./gradlew downloadRepos

# Copy the actual application source code
COPY . .
COPY pb ./proto

# Compile and package the Java application
RUN ./gradlew installDist -PprotoSourceDir=./proto

# ==========================================
# Stage 2: Runtime Stage (The Lightweight Production Image)
# ==========================================
FROM eclipse-temurin:21-jre

# Set the working directory
WORKDIR /usr/src/app/

# Copy ONLY the built application from the 'builder' stage
COPY --from=builder /usr/src/app/ /usr/src/app/

# Set Environment Variables
ENV AD_PORT=9099

# Define the Entry Point (The script generated by installDist)
ENTRYPOINT ["./build/install/opentelemetry-demo-ad/bin/Ad"]